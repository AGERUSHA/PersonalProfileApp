@model PersonalProfileApp.Models.StudentProfile
@{
    ViewData["Title"] = "Портфолио";
}

<h2>Портфолио</h2>
<p>@Model.FullName орындаған жобалар:</p>

<div class="row">
    @foreach (var project in Model.Projects)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@project.Title</h5>
                    <p class="card-text">@project.Description</p>
                    <p class="text-muted small mb-0">Технологиялар: @project.Technologies</p>
                </div>
            </div>
        </div>
    }
</div>

<h4 class="mt-3">Дағдылар</h4>
<p>@string.Join(", ", Model.Skills)</p>

<h4>Байланыс</h4>
<p>
    Email: <a href="mailto:@Model.Email">@Model.Email</a> ·
    GitHub: <a href="@Model.GitHub" target="_blank">@Model.GitHub</a>
</p>
